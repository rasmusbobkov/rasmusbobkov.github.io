---
/**
 * The app shell. Components carry structure only — every string this page
 * renders is a `data-i18n` key resolved from the single interface message
 * catalogue (Estonian default, rendered here so the page works before JS; the
 * client re-localizes on switch).
 */
import { t, DEFAULT_LANG } from '../messages/catalogue';
import { MIN_BIRTH_YEAR, maxBirthYear, monthName, SEED_BIRTH_ENTRY } from '../lib/birth-wheels';
import { PLACE_DATA_URL, SOURCE_URL } from '../lib/licence';
import '../styles/global.css';
const L = DEFAULT_LANG;
const tx = (key: Parameters<typeof t>[1]) => t(L, key);

// The deployment base, from the one place that declares it (astro.config.mjs):
// the page is published under it, so its own asset links have to carry it too.
// Astro hands back the value verbatim, so the separator is added here once.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

// The source offer, shown as the address itself: the link text is the URL
// without its scheme, so one constant holds the whole address (AGPL-3.0 §13).
const sourceLabel = SOURCE_URL.replace(/^https?:\/\//, '');

// Default birth entry: the example value the form has always shown; the
// wheels and the text fields agree on it from the first paint — the same
// constant app.ts seeds the client state from, not a second copy.
const seed = SEED_BIRTH_ENTRY;

// The one shared year bound: floor 1800, ceiling = the current calendar
// year, computed at runtime — the same bound the parser and import
// validation read, so no second range exists anywhere. (The build bakes
// the option list; app.ts re-renders it against maxBirthYear() at run time.)
const YEAR_MIN = MIN_BIRTH_YEAR;
const YEAR_MAX = maxBirthYear();
const years = Array.from({ length: YEAR_MAX - YEAR_MIN + 1 }, (_, i) => YEAR_MIN + i);
const pad2 = (n: number) => String(n).padStart(2, '0');
---

<!doctype html>
<html lang="et">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={tx('app.description')} />
    <title>{tx('app.name')}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${base}fonts/fonts.css`} />
  </head>
  <body>
    <header class="site-head wrap">
      <div class="mark">
        <span class="mark-dot" aria-hidden="true"></span>
        <span class="mark-name" data-i18n="app.name">{tx('app.name')}</span>
      </div>
      <nav class="lang-switch" aria-label={tx('lang.label')}>
        <button id="lang-et" class="chip" data-i18n="lang.et">{tx('lang.et')}</button>
        <button id="lang-en" class="chip" data-i18n="lang.en">{tx('lang.en')}</button>
        <span id="lang-coming" class="note" hidden data-i18n="app.comingSoon">{tx('app.comingSoon')}</span>
      </nav>
    </header>

    <main class="wrap">
      <!-- shared trio view (from a share link) -->
      <section id="shareview" hidden class="card">
        <h2 data-i18n="shareview.heading">{tx('shareview.heading')}</h2>
        <p class="note" data-i18n="shareview.lede">{tx('shareview.lede')}</p>
        <ul id="shareview-list"></ul>
        <button id="shareview-cta" class="primary" data-i18n="shareview.cta">{tx('shareview.cta')}</button>
      </section>

      <!-- one-time focus setup (before the first daily story) -->
      <section id="focus-setup" hidden class="focus-card" aria-labelledby="focus-heading">
        <p class="day-date" data-i18n="focus.eyebrow">{tx('focus.eyebrow')}</p>
        <h2 id="focus-heading" class="day-title" data-i18n="focus.heading">{tx('focus.heading')}</h2>
        <p class="note" data-i18n="focus.lede">{tx('focus.lede')}</p>
        <div class="focus-chips" role="group" aria-labelledby="focus-heading">
          <label class="focus-chip">
            <input type="checkbox" class="focus-option" value="work" />
            <span class="focus-name" data-i18n="focus.work">{tx('focus.work')}</span>
            <span class="focus-hint" data-i18n="focus.work.hint">{tx('focus.work.hint')}</span>
          </label>
          <label class="focus-chip">
            <input type="checkbox" class="focus-option" value="relationships" />
            <span class="focus-name" data-i18n="focus.relationships">{tx('focus.relationships')}</span>
            <span class="focus-hint" data-i18n="focus.relationships.hint">{tx('focus.relationships.hint')}</span>
          </label>
          <label class="focus-chip">
            <input type="checkbox" class="focus-option" value="creative" />
            <span class="focus-name" data-i18n="focus.creative">{tx('focus.creative')}</span>
            <span class="focus-hint" data-i18n="focus.creative.hint">{tx('focus.creative.hint')}</span>
          </label>
          <label class="focus-chip">
            <input type="checkbox" class="focus-option" value="money" />
            <span class="focus-name" data-i18n="focus.money">{tx('focus.money')}</span>
            <span class="focus-hint" data-i18n="focus.money.hint">{tx('focus.money.hint')}</span>
          </label>
          <label class="focus-chip">
            <input type="checkbox" class="focus-option" value="home-family" />
            <span class="focus-name" data-i18n="focus.home-family">{tx('focus.home-family')}</span>
            <span class="focus-hint" data-i18n="focus.home-family.hint">{tx('focus.home-family.hint')}</span>
          </label>
          <label class="focus-chip">
            <input type="checkbox" class="focus-option" value="body-health" />
            <span class="focus-name" data-i18n="focus.body-health">{tx('focus.body-health')}</span>
            <span class="focus-hint" data-i18n="focus.body-health.hint">{tx('focus.body-health.hint')}</span>
          </label>
        </div>
        <p id="focus-note" class="error-line" role="alert"></p>
        <div class="day-block focus-how">
          <h4 class="day-label" data-i18n="focus.howHeading">{tx('focus.howHeading')}</h4>
          <p class="day-text" data-i18n="focus.how">{tx('focus.how')}</p>
        </div>
        <p class="note focus-storage" data-i18n="focus.storage">{tx('focus.storage')}</p>
        <div class="focus-actions">
          <button id="focus-save" type="button" class="primary" data-i18n="focus.save">{tx('focus.save')}</button>
          <button id="focus-skip" type="button" class="ghost" data-i18n="focus.skip">{tx('focus.skip')}</button>
        </div>
      </section>

      <!-- daily story: the landing surface -->
      <section id="story-view" hidden class="story-view">
        <div class="story-head">
          <p class="day-date">
            <span id="story-date-text"></span>
            <span id="story-asof" class="note"></span>
          </p>
          <h2 id="story-title" class="day-title" data-i18n="story.heading">{tx('story.heading')}</h2>
          <div class="tier-switch" role="group" aria-label={tx('story.tierSwitch')}>
            <button id="tier-plain" class="chip" aria-pressed="true" data-i18n="story.tierPlain">{tx('story.tierPlain')}</button>
            <button id="tier-story" class="chip" aria-pressed="false" data-i18n="story.tierStory">{tx('story.tierStory')}</button>
          </div>
        </div>
        <div id="story-content" class="story-body" aria-live="polite">
          <p id="story-loading" class="note" data-i18n="story.loading">{tx('story.loading')}</p>
        </div>
        <p id="story-focus-note" class="story-focus-note" aria-live="polite" hidden></p>
        <div class="story-actions">
          <button id="story-why" class="ghost" aria-expanded="false" aria-controls="story-why-panel" data-i18n="story.why">{tx('story.why')}</button>
          <button id="open-chart" class="ghost" data-i18n="story.openChart">{tx('story.openChart')}</button>
        </div>
        <div id="story-why-panel" class="why-sheet" hidden></div>
      </section>

      <!-- birth entry -->
      <section id="birth-form" hidden class="card birth-card">
        <h2 data-i18n="form.heading">{tx('form.heading')}</h2>
        <p class="note" data-i18n="form.lede">{tx('form.lede')}</p>
        <form id="birth-form-el" novalidate>
          <fieldset id="birth-date-wheels" class="birth-wheels">
            <legend data-i18n="form.date">{tx('form.date')}</legend>
            <div class="wheel-row">
              <div class="wheel-col wheel-col-day">
                <span class="wheel-label" id="birth-day-label" data-i18n="form.day">{tx('form.day')}</span>
                <div class="wheel-frame">
                  <div class="wheel" role="listbox" id="birth-day" aria-labelledby="birth-day-label" tabindex="0" aria-activedescendant={`birth-day-opt-${seed.day}`}>
                    <div class="wheel-pad" aria-hidden="true"></div>
                    <div class="wheel-pad" aria-hidden="true"></div>
                    {Array.from({ length: 31 }, (_, i) => i + 1).map((d) => (
                      <div class="wheel-item" id={`birth-day-opt-${d}`} role="option" aria-selected={d === seed.day}>{pad2(d)}</div>
                    ))}
                    <div class="wheel-pad" aria-hidden="true"></div>
                    <div class="wheel-pad" aria-hidden="true"></div>
                  </div>
                  <span class="wheel-band" aria-hidden="true"></span>
                </div>
              </div>
              <div class="wheel-col wheel-col-month">
                <span class="wheel-label" id="birth-month-label" data-i18n="form.month">{tx('form.month')}</span>
                <div class="wheel-frame">
                  <div class="wheel" role="listbox" id="birth-month" aria-labelledby="birth-month-label" tabindex="0" aria-activedescendant={`birth-month-opt-${seed.month}`}>
                    <div class="wheel-pad" aria-hidden="true"></div>
                    <div class="wheel-pad" aria-hidden="true"></div>
                    {Array.from({ length: 12 }, (_, i) => i + 1).map((m) => (
                      <div class="wheel-item" id={`birth-month-opt-${m}`} role="option" aria-selected={m === seed.month}>{monthName(L, m)}</div>
                    ))}
                    <div class="wheel-pad" aria-hidden="true"></div>
                    <div class="wheel-pad" aria-hidden="true"></div>
                  </div>
                  <span class="wheel-band" aria-hidden="true"></span>
                </div>
              </div>
              <div class="wheel-col wheel-col-year">
                <span class="wheel-label" id="birth-year-label" data-i18n="form.year">{tx('form.year')}</span>
                <div class="wheel-frame">
                  <div class="wheel" role="listbox" id="birth-year" aria-labelledby="birth-year-label" tabindex="0" aria-activedescendant={`birth-year-opt-${seed.year}`}>
                    <div class="wheel-pad" aria-hidden="true"></div>
                    <div class="wheel-pad" aria-hidden="true"></div>
                    {years.map((y) => (
                      <div class="wheel-item" id={`birth-year-opt-${y}`} role="option" aria-selected={y === seed.year}>{y}</div>
                    ))}
                    <div class="wheel-pad" aria-hidden="true"></div>
                    <div class="wheel-pad" aria-hidden="true"></div>
                  </div>
                  <span class="wheel-band" aria-hidden="true"></span>
                </div>
              </div>
            </div>
          </fieldset>
          <div class="field">
            <label for="birth-date" data-i18n="form.dateText">{tx('form.dateText')}</label>
            <input id="birth-date" name="date" inputmode="numeric" placeholder={tx('form.date.placeholder')} />
            <p class="note" data-i18n="form.dateText.hint">{tx('form.dateText.hint')}</p>
          </div>

          <fieldset id="birth-time-wheels" class="birth-wheels">
            <legend data-i18n="form.time">{tx('form.time')}</legend>
            <div class="wheel-row">
              <div class="wheel-col">
                <span class="wheel-label" id="birth-hour-label" data-i18n="form.hour">{tx('form.hour')}</span>
                <div class="wheel-frame">
                  <div class="wheel" role="listbox" id="birth-hour" aria-labelledby="birth-hour-label" tabindex="0" aria-activedescendant={`birth-hour-opt-${seed.hour}`}>
                    <div class="wheel-pad" aria-hidden="true"></div>
                    <div class="wheel-pad" aria-hidden="true"></div>
                    {Array.from({ length: 24 }, (_, i) => i).map((h) => (
                      <div class="wheel-item" id={`birth-hour-opt-${h}`} role="option" aria-selected={h === seed.hour}>{pad2(h)}</div>
                    ))}
                    <div class="wheel-pad" aria-hidden="true"></div>
                    <div class="wheel-pad" aria-hidden="true"></div>
                  </div>
                  <span class="wheel-band" aria-hidden="true"></span>
                </div>
              </div>
              <div class="wheel-col">
                <span class="wheel-label" id="birth-minute-label" data-i18n="form.minute">{tx('form.minute')}</span>
                <div class="wheel-frame">
                  <div class="wheel" role="listbox" id="birth-minute" aria-labelledby="birth-minute-label" tabindex="0" aria-activedescendant={`birth-minute-opt-${seed.minute}`}>
                    <div class="wheel-pad" aria-hidden="true"></div>
                    <div class="wheel-pad" aria-hidden="true"></div>
                    {Array.from({ length: 60 }, (_, i) => i).map((m) => (
                      <div class="wheel-item" id={`birth-minute-opt-${m}`} role="option" aria-selected={m === seed.minute}>{pad2(m)}</div>
                    ))}
                    <div class="wheel-pad" aria-hidden="true"></div>
                    <div class="wheel-pad" aria-hidden="true"></div>
                  </div>
                  <span class="wheel-band" aria-hidden="true"></span>
                </div>
              </div>
            </div>
            <p class="note" data-i18n="form.time.hint">{tx('form.time.hint')}</p>
          </fieldset>
          <div class="field">
            <label for="birth-time" data-i18n="form.timeText">{tx('form.timeText')}</label>
            <input id="birth-time" name="time" inputmode="numeric" placeholder={tx('form.time.placeholder')} />
            <p class="note" data-i18n="form.timeText.hint">{tx('form.timeText.hint')}</p>
          </div>
          <div class="field">
            <label for="birth-place" data-i18n="form.place">{tx('form.place')}</label>
            <input id="birth-place" name="place" autocomplete="off" placeholder={tx('form.place.placeholder')} />
            <p class="note" data-i18n="form.place.hint">{tx('form.place.hint')}</p>
            <ul id="place-results" class="place-results" hidden></ul>
          </div>
          <div class="field checkbox-field">
            <label class="checkbox-row">
              <input id="birth-unknown-time" name="unknownTime" type="checkbox" />
              <span data-i18n="form.unknownTime">{tx('form.unknownTime')}</span>
            </label>
            <p class="note" data-i18n="form.unknownTime.note">{tx('form.unknownTime.note')}</p>
          </div>
          <p id="form-error" class="error-line" role="alert"></p>
          <button id="form-submit" type="submit" class="primary" data-i18n="form.submit">{tx('form.submit')}</button>
        </form>
      </section>

      <!-- chart view -->
      <section id="chart-view" hidden>
        <div class="chart-head">
          <h2 data-i18n="chart.heading">{tx('chart.heading')}</h2>
          <p id="chart-born" class="chart-born"></p>
          <p id="chart-progress" hidden class="note" data-i18n="misc.calculating">{tx('misc.calculating')}</p>
          <p id="chart-unknown-time-banner" hidden class="banner note" data-i18n="chart.unknownTimeBanner">{tx('chart.unknownTimeBanner')}</p>
          <p id="chart-time-note" hidden class="note" data-i18n="time.ambiguousFallback">{tx('time.ambiguousFallback')}</p>
        </div>

        <div class="chart-layout">
          <figure class="wheel-fig">
            <svg id="chart-wheel-svg" class="wheel-svg" aria-label={tx('chart.wheel.aria')}></svg>
            <figcaption class="note" data-i18n="chart.wheel.tapHint">{tx('chart.wheel.tapHint')}</figcaption>
          </figure>
          <aside class="detail-panel card" aria-live="polite">
            <h3 id="detail-panel-heading" data-i18n="chart.detailsHeading">{tx('chart.detailsHeading')}</h3>
            <div id="detail-panel-body" class="detail-body">
              <div data-i18n="chart.detailsEmpty">{tx('chart.detailsEmpty')}</div>
            </div>
          </aside>
        </div>

        <section class="lists card">
          <h3 data-i18n="chart.listHeading">{tx('chart.listHeading')}</h3>
          <p class="note" data-i18n="chart.listNote">{tx('chart.listNote')}</p>
          <div class="lists-grid">
            <div>
              <h4 data-i18n="chart.planetsHeading">{tx('chart.planetsHeading')}</h4>
              <ul id="list-planets"></ul>
            </div>
            <div id="houses-block">
              <h4 data-i18n="chart.housesHeading">{tx('chart.housesHeading')}</h4>
              <ul id="list-houses"></ul>
            </div>
            <div>
              <h4 data-i18n="chart.aspectsHeading">{tx('chart.aspectsHeading')}</h4>
              <ul id="list-aspects"></ul>
            </div>
          </div>
        </section>

        <section class="data-panel">
          <div class="card">
            <h3 data-i18n="share.heading">{tx('share.heading')}</h3>
            <p class="note" data-i18n="share.lede">{tx('share.lede')}</p>
            <button id="share-copy" class="chip" data-i18n="share.copy">{tx('share.copy')}</button>
            <span id="share-note" class="note"></span>
          </div>
          <div class="card">
            <h3 data-i18n="export.heading">{tx('export.heading')}</h3>
            <p class="note" data-i18n="export.lede">{tx('export.lede')}</p>
            <button id="export-json" class="chip" data-i18n="export.button">{tx('export.button')}</button>
          </div>
          <div class="card">
            <h3 data-i18n="import.heading">{tx('import.heading')}</h3>
            <button id="import-json" class="chip" data-i18n="import.button">{tx('import.button')}</button>
            <span id="import-note" class="note"></span>
          </div>
          <div class="card">
            <button id="focus-reopen" class="chip" data-i18n="focus.edit">{tx('focus.edit')}</button>
          </div>
          <div class="card">
            <button id="reset-data" class="chip" data-i18n="reset.button">{tx('reset.button')}</button>
          </div>
        </section>
      </section>

      <!-- glossary -->
      <section class="glossary card">
        <button id="glossary-toggle" class="chip" data-i18n="glossary.heading">{tx('glossary.heading')}</button>
        <div id="glossary-panel" hidden class="glossary-entries">
          <p class="note" data-i18n="glossary.lede">{tx('glossary.lede')}</p>
          <dl>
            <dt data-i18n="glossary.birthChart">{tx('glossary.birthChart')}</dt>
            <dd data-i18n="glossary.birthChart.desc">{tx('glossary.birthChart.desc')}</dd>
            <dt data-i18n="glossary.rising">{tx('glossary.rising')}</dt>
            <dd data-i18n="glossary.rising.desc">{tx('glossary.rising.desc')}</dd>
            <dt data-i18n="glossary.sunSign">{tx('glossary.sunSign')}</dt>
            <dd data-i18n="glossary.sunSign.desc">{tx('glossary.sunSign.desc')}</dd>
            <dt data-i18n="glossary.moonSign">{tx('glossary.moonSign')}</dt>
            <dd data-i18n="glossary.moonSign.desc">{tx('glossary.moonSign.desc')}</dd>
            <dt data-i18n="glossary.house">{tx('glossary.house')}</dt>
            <dd data-i18n="glossary.house.desc">{tx('glossary.house.desc')}</dd>
            <dt data-i18n="glossary.aspect">{tx('glossary.aspect')}</dt>
            <dd data-i18n="glossary.aspect.desc">{tx('glossary.aspect.desc')}</dd>
            <dt data-i18n="glossary.conjunction">{tx('glossary.conjunction')}</dt>
            <dd data-i18n="glossary.conjunction.desc">{tx('glossary.conjunction.desc')}</dd>
            <dt data-i18n="glossary.sextile">{tx('glossary.sextile')}</dt>
            <dd data-i18n="glossary.sextile.desc">{tx('glossary.sextile.desc')}</dd>
            <dt data-i18n="glossary.square">{tx('glossary.square')}</dt>
            <dd data-i18n="glossary.square.desc">{tx('glossary.square.desc')}</dd>
            <dt data-i18n="glossary.trine">{tx('glossary.trine')}</dt>
            <dd data-i18n="glossary.trine.desc">{tx('glossary.trine.desc')}</dd>
            <dt data-i18n="glossary.opposition">{tx('glossary.opposition')}</dt>
            <dd data-i18n="glossary.opposition.desc">{tx('glossary.opposition.desc')}</dd>
            <dt data-i18n="glossary.asc">{tx('glossary.asc')}</dt>
            <dd data-i18n="glossary.asc.desc">{tx('glossary.asc.desc')}</dd>
            <dt data-i18n="glossary.orb">{tx('glossary.orb')}</dt>
            <dd data-i18n="glossary.orb.desc">{tx('glossary.orb.desc')}</dd>
            <dt data-i18n="glossary.retrograde">{tx('glossary.retrograde')}</dt>
            <dd data-i18n="glossary.retrograde.desc">{tx('glossary.retrograde.desc')}</dd>
          </dl>
        </div>
      </section>
    </main>

    <footer class="site-foot wrap">
      <p class="note" data-i18n="form.lede">{tx('form.lede')}</p>
      <p class="note foot-credit">
        <span data-i18n="foot.licence">{tx('foot.licence')}</span>
        <a href={SOURCE_URL} rel="noopener">{sourceLabel}</a>
      </p>
      <p class="note foot-credit">
        <a href={PLACE_DATA_URL} rel="noopener" data-i18n="foot.places">{tx('foot.places')}</a>
      </p>
    </footer>

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>

<style>
  .site-head { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px 8px; }
  .story-view, .focus-card { max-width: 440px; margin: 0 auto; background: var(--ink-2); border: 1px solid var(--line); border-radius: 24px; padding: 24px 22px 26px; }
  .story-head { min-width: 0; }
  .tier-switch { display: inline-flex; gap: 4px; padding: 3px; border: 1px solid var(--line); border-radius: 999px; margin-top: 4px; }
  .tier-switch .chip { border: 0; border-radius: 999px; background: transparent; color: var(--muted); font-family: var(--body); font-size: 12.5px; letter-spacing: .01em; padding: 5px 15px; }
  .tier-switch .chip[aria-pressed="true"] { background: var(--gold-dim); color: var(--paper); }
  .story-actions { display: flex; gap: 8px; margin-top: 18px; }
  .story-actions .ghost { flex: 1 1 0; }
  .story-focus-note { margin: 16px 0 0; font-size: 12.5px; line-height: 1.55; color: var(--faint); }
  .why-sheet { margin-top: 16px; background: var(--ink-3); border: 1px solid var(--line); border-radius: 18px; padding: 18px; }
  .focus-chips { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; margin-top: 16px; }
  .focus-chip { position: relative; display: flex; flex-direction: column; gap: 2px; min-width: 0; margin: 0; border: 1px solid var(--line); border-radius: 13px; padding: 10px 12px 9px; cursor: pointer; }
  .focus-chip input { position: absolute; width: 1px; height: 1px; opacity: 0; }
