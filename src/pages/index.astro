---
/**
 * The app shell. Components carry structure only — every user-facing string
 * is a `data-i18n` key resolved from the single message catalogue (Estonian
 * default, rendered here so the page works before JS; the client re-localizes
 * on switch).
 */
import { t, DEFAULT_LANG } from '../messages/catalogue';
import '../styles/global.css';
const L = DEFAULT_LANG;
const tx = (key: Parameters<typeof t>[1]) => t(L, key);
---
<!doctype html>
<html lang="et">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={tx('app.description')} />
    <title>{tx('app.name')}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body>
    <header class="site-head wrap">
      <div class="mark">
        <span class="mark-dot" aria-hidden="true"></span>
        <span class="mark-name" data-i18n="app.name">{tx('app.name')}</span>
      </div>
      <nav class="lang-switch" aria-label={tx('lang.label')}>
        <button id="lang-et" class="chip" data-i18n="lang.et">{tx('lang.et')}</button>
        <button id="lang-en" class="chip" data-i18n="lang.en">{tx('lang.en')}</button>
        <span id="lang-coming" class="note" hidden data-i18n="app.comingSoon">{tx('app.comingSoon')}</span>
      </nav>
    </header>

    <main class="wrap">
      <!-- shared trio view (from a share link) -->
      <section id="shareview" hidden class="card">
        <h2 data-i18n="shareview.heading">{tx('shareview.heading')}</h2>
        <p class="note" data-i18n="shareview.lede">{tx('shareview.lede')}</p>
        <ul id="shareview-list"></ul>
        <button id="shareview-cta" class="primary" data-i18n="shareview.cta">{tx('shareview.cta')}</button>
      </section>

      <!-- birth entry -->
      <section id="birth-form" hidden class="card birth-card">
        <h2 data-i18n="form.heading">{tx('form.heading')}</h2>
        <p class="note" data-i18n="form.lede">{tx('form.lede')}</p>
        <form id="birth-form-el" novalidate>
          <div class="field">
            <label for="birth-date" data-i18n="form.date">{tx('form.date')}</label>
            <input id="birth-date" name="date" inputmode="numeric" placeholder={tx('form.date.placeholder')} />
          </div>
          <div class="field">
            <label for="birth-time" data-i18n="form.time">{tx('form.time')}</label>
            <input id="birth-time" name="time" inputmode="numeric" placeholder={tx('form.time.placeholder')} />
            <p class="note" data-i18n="form.time.hint">{tx('form.time.hint')}</p>
          </div>
          <div class="field">
            <label for="birth-place" data-i18n="form.place">{tx('form.place')}</label>
            <input id="birth-place" name="place" autocomplete="off" placeholder={tx('form.place.placeholder')} />
            <p class="note" data-i18n="form.place.hint">{tx('form.place.hint')}</p>
            <ul id="place-results" class="place-results" hidden></ul>
          </div>
          <div class="field checkbox-field">
            <label class="checkbox-row">
              <input id="birth-unknown-time" name="unknownTime" type="checkbox" />
              <span data-i18n="form.unknownTime">{tx('form.unknownTime')}</span>
            </label>
            <p class="note" data-i18n="form.unknownTime.note">{tx('form.unknownTime.note')}</p>
          </div>
          <p id="form-error" class="error-line" role="alert"></p>
          <button id="form-submit" type="submit" class="primary" data-i18n="form.submit">{tx('form.submit')}</button>
        </form>
      </section>

      <!-- chart view -->
      <section id="chart-view" hidden>
        <div class="chart-head">
          <h2 data-i18n="chart.heading">{tx('chart.heading')}</h2>
          <p id="chart-born" class="chart-born"></p>
          <p id="chart-progress" hidden class="note" data-i18n="misc.calculating">{tx('misc.calculating')}</p>
          <p id="chart-unknown-time-banner" hidden class="banner note" data-i18n="chart.unknownTimeBanner">{tx('chart.unknownTimeBanner')}</p>
          <p id="chart-time-note" hidden class="note" data-i18n="time.ambiguousFallback">{tx('time.ambiguousFallback')}</p>
        </div>

        <div class="chart-layout">
          <figure class="wheel-fig">
            <svg id="chart-wheel-svg" class="wheel-svg" aria-label={tx('chart.wheel.aria')}></svg>
            <figcaption class="note" data-i18n="chart.wheel.tapHint">{tx('chart.wheel.tapHint')}</figcaption>
          </figure>
          <aside class="detail-panel card" aria-live="polite">
            <h3 id="detail-panel-heading" data-i18n="chart.detailsHeading">{tx('chart.detailsHeading')}</h3>
            <div id="detail-panel-body" class="detail-body">
              <div data-i18n="chart.detailsEmpty">{tx('chart.detailsEmpty')}</div>
            </div>
          </aside>
        </div>

        <section class="lists card">
          <h3 data-i18n="chart.listHeading">{tx('chart.listHeading')}</h3>
          <p class="note" data-i18n="chart.listNote">{tx('chart.listNote')}</p>
          <div class="lists-grid">
            <div>
              <h4 data-i18n="chart.planetsHeading">{tx('chart.planetsHeading')}</h4>
              <ul id="list-planets"></ul>
            </div>
            <div id="houses-block">
              <h4 data-i18n="chart.housesHeading">{tx('chart.housesHeading')}</h4>
              <ul id="list-houses"></ul>
            </div>
            <div>
              <h4 data-i18n="chart.aspectsHeading">{tx('chart.aspectsHeading')}</h4>
              <ul id="list-aspects"></ul>
            </div>
          </div>
        </section>

        <section class="data-panel">
          <div class="card">
            <h3 data-i18n="share.heading">{tx('share.heading')}</h3>
            <p class="note" data-i18n="share.lede">{tx('share.lede')}</p>
            <button id="share-copy" class="chip" data-i18n="share.copy">{tx('share.copy')}</button>
            <span id="share-note" class="note"></span>
          </div>
          <div class="card">
            <h3 data-i18n="export.heading">{tx('export.heading')}</h3>
            <p class="note" data-i18n="export.lede">{tx('export.lede')}</p>
            <button id="export-json" class="chip" data-i18n="export.button">{tx('export.button')}</button>
          </div>
          <div class="card">
            <h3 data-i18n="import.heading">{tx('import.heading')}</h3>
            <button id="import-json" class="chip" data-i18n="import.button">{tx('import.button')}</button>
            <span id="import-note" class="note"></span>
          </div>
          <div class="card">
            <button id="reset-data" class="chip" data-i18n="reset.button">{tx('reset.button')}</button>
          </div>
        </section>
      </section>

      <!-- glossary -->
      <section class="glossary card">
        <button id="glossary-toggle" class="chip" data-i18n="glossary.heading">{tx('glossary.heading')}</button>
        <div id="glossary-panel" hidden class="glossary-entries">
          <p class="note" data-i18n="glossary.lede">{tx('glossary.lede')}</p>
          <dl>
            <dt data-i18n="glossary.birthChart">{tx('glossary.birthChart')}</dt>
            <dd data-i18n="glossary.birthChart.desc">{tx('glossary.birthChart.desc')}</dd>
            <dt data-i18n="glossary.rising">{tx('glossary.rising')}</dt>
            <dd data-i18n="glossary.rising.desc">{tx('glossary.rising.desc')}</dd>
            <dt data-i18n="glossary.sunSign">{tx('glossary.sunSign')}</dt>
            <dd data-i18n="glossary.sunSign.desc">{tx('glossary.sunSign.desc')}</dd>
            <dt data-i18n="glossary.moonSign">{tx('glossary.moonSign')}</dt>
            <dd data-i18n="glossary.moonSign.desc">{tx('glossary.moonSign.desc')}</dd>
            <dt data-i18n="glossary.house">{tx('glossary.house')}</dt>
            <dd data-i18n="glossary.house.desc">{tx('glossary.house.desc')}</dd>
            <dt data-i18n="glossary.aspect">{tx('glossary.aspect')}</dt>
            <dd data-i18n="glossary.aspect.desc">{tx('glossary.aspect.desc')}</dd>
            <dt data-i18n="glossary.conjunction">{tx('glossary.conjunction')}</dt>
            <dd data-i18n="glossary.conjunction.desc">{tx('glossary.conjunction.desc')}</dd>
            <dt data-i18n="glossary.sextile">{tx('glossary.sextile')}</dt>
            <dd data-i18n="glossary.sextile.desc">{tx('glossary.sextile.desc')}</dd>
            <dt data-i18n="glossary.square">{tx('glossary.square')}</dt>
            <dd data-i18n="glossary.square.desc">{tx('glossary.square.desc')}</dd>
            <dt data-i18n="glossary.trine">{tx('glossary.trine')}</dt>
            <dd data-i18n="glossary.trine.desc">{tx('glossary.trine.desc')}</dd>
            <dt data-i18n="glossary.opposition">{tx('glossary.opposition')}</dt>
            <dd data-i18n="glossary.opposition.desc">{tx('glossary.opposition.desc')}</dd>
            <dt data-i18n="glossary.asc">{tx('glossary.asc')}</dt>
            <dd data-i18n="glossary.asc.desc">{tx('glossary.asc.desc')}</dd>
            <dt data-i18n="glossary.orb">{tx('glossary.orb')}</dt>
            <dd data-i18n="glossary.orb.desc">{tx('glossary.orb.desc')}</dd>
            <dt data-i18n="glossary.retrograde">{tx('glossary.retrograde')}</dt>
            <dd data-i18n="glossary.retrograde.desc">{tx('glossary.retrograde.desc')}</dd>
          </dl>
        </div>
      </section>
    </main>

    <footer class="site-foot wrap">
      <p class="note" data-i18n="form.lede">{tx('form.lede')}</p>
    </footer>

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>

<style>
  .site-head { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px 8px; }
  .mark { display: flex; align-items: center; gap: 12px; }
  .mark-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 22px 4px rgba(198, 161, 95, .45); }
  .mark-name { font-family: var(--mono); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--faint); }
  .lang-switch { display: flex; align-items: center; gap: 8px; max-width: 46ch; }
  main { padding-bottom: 60px; }
  main > * + * { margin-top: 20px; }
  .birth-card { max-width: 560px; margin: 0 auto; }
  .field { margin-top: 18px; }
  .checkbox-row { display: flex; gap: 10px; align-items: center; text-transform: none; font-family: var(--body); font-size: 14.5px; color: var(--paper); letter-spacing: 0; }
  .checkbox-row input { width: auto; }
  .place-results { list-style: none; margin: 6px 0; padding: 0; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; max-height: 260px; overflow-y: auto; }
  .place-results li { border-bottom: 1px solid var(--line); }
  .place-results li:last-child { border-bottom: 0; }
  .place-results button { display: block; width: 100%; text-align: left; border: 0; border-radius: 0; padding: 9px 14px; font-size: 14px; background: var(--ink-2); color: var(--paper); }
  .place-results button:hover { background: var(--ink-3); color: var(--gold); }
  .error-line { color: var(--rose); font-size: 13.5px; min-height: 1.4em; margin: 14px 0 8px; }
  .banner { color: var(--gold); background: var(--gold-dim); border: 1px solid rgba(198, 161, 95, .3); border-radius: 10px; padding: 10px 14px; }
  .chart-head h2 { margin-bottom: 6px; }
  .chart-born { font-family: var(--display); font-style: italic; color: var(--gold); margin: 4px 0; }
  .wheel-svg { width: 100%; height: auto; max-width: 520px; }
  .wheel-fig { margin: 0; min-width: 0; }
  .wheel-hit { cursor: pointer; }
  .wheel-hit:focus-visible, .wheel-aspect:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  .detail-panel h3 { margin-bottom: 10px; }
  .detail-body div + div { margin-top: 8px; }
  .lists h3 { margin-bottom: 10px; }
  .lists-grid { display: grid; gap: 18px; }
  @media (min-width: 880px) { .lists-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .lists ul { list-style: none; padding: 0; margin: 0; }
  .lists li { padding: 5px 0; border-bottom: 1px solid var(--line); font-size: 14px; min-width: 0; overflow-wrap: break-word; }
  .lists li:last-child { border-bottom: 0; }
  .data-panel { display: grid; gap: 14px; }
  @media (min-width: 880px) { .data-panel { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .glossary dl { margin: 14px 0 0; display: grid; gap: 8px 18px; }
  @media (min-width: 700px) { .glossary dl { grid-template-columns: max-content minmax(0, 1fr); } }
  .glossary dt { font-family: var(--display); font-style: italic; color: var(--gold); }
  .glossary dd { margin: 0; font-size: 13.5px; color: var(--muted); min-width: 0; }
  .site-foot { padding: 20px 24px 40px; border-top: 1px solid var(--line); margin-top: 40px; }
</style>
